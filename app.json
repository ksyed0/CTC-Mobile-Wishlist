{
  "expo": {
    "name": "CTC Mobile Wishlist",
    "slug": "ctc-mobile-wishlist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#D52B1E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ctc.mobilewishlist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D52B1E"
      },
      "package": "com.ctc.mobilewishlist"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "ctcwishlist"
  }
}
