{
  "name": "ctc-mobile-wishlist",
  "version": "1.0.0",
  "description": "CTC Mobile Wishlist",
  "private": true,
  "scripts": {
    "test": "jest --watchAll=false",
    "test:coverage": "jest --watchAll=false --coverage",
    "plan:test": "jest --watchAll=false",
    "plan:test:coverage": "jest --watchAll=false --coverage",
    "plan:generate": "node tools/generate-plan.js",
    "dashboard": "node tools/generate-dashboard.js",
    "dashboard:watch": "node tools/generate-dashboard.js --watch",
    "avatars": "node tools/process-avatars.js",
    "init:status": "node tools/init-sdlc-status.js",
    "build": "npm run avatars && npm run plan:generate && npm run dashboard",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,json,md,yml,yaml}": "prettier --write",
    "*.js": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "canvas": "^3.2.3",
    "eslint": "10.0.3",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tracking": "^1.1.3"
  }
}
