{
  "name": "ctc-mobile-wishlist",
  "version": "1.0.0",
  "description": "CTC Mobile Wishlist",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "test": "jest --watchAll=false",
    "test:coverage": "jest --watchAll=false --coverage",
    "plan:test": "jest --watchAll=false",
    "plan:test:coverage": "jest --watchAll=false --coverage",
    "plan:generate": "node tools/generate-plan.js",
    "plan:watch": "node tools/generate-plan.js --watch",
    "dashboard": "node tools/generate-dashboard.js",
    "dashboard:watch": "node tools/generate-dashboard.js --watch",
    "avatars": "node tools/process-avatars.js",
    "init:status": "node tools/init-sdlc-status.js",
    "build": "npm run avatars && npm run plan:generate && npm run dashboard",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,json,md,yml,yaml}": "prettier --write",
    "*.js": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "canvas": "^3.2.3",
    "eslint": "10.0.3",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tracking": "^1.1.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^55.0.11",
    "expo-camera": "~55.0.13",
    "expo-constants": "~55.0.11",
    "expo-font": "~55.0.6",
    "expo-linking": "~55.0.11",
    "expo-router": "^55.0.10",
    "expo-splash-screen": "^55.0.15",
    "expo-status-bar": "^55.0.5",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.4",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
  }
}
